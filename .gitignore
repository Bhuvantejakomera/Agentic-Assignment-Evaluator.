workbooks/*.xlsx
reports/
!workbooks/.gitkeep
!reports/.gitkeep
!data/.gitkeep

# Sensitive Google Cloud & OAuth Credentials
credentials.json
token.json
*.pem
*.key
.env
.env.*
!.env.example

